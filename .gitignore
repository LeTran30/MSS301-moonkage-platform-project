# =============================================
# Moonkage Platform — Comprehensive .gitignore
# =============================================

# ── Java / Maven ──
target/
!**/src/main/**/target/
!**/src/test/**/target/
*.class
*.jar
!**/.mvn/wrapper/maven-wrapper.jar
*.war
*.ear
*.log
*.nar
*.rar
*.tar.gz
*.zip

# ── Spring Boot ──
*.pid
.springBeans

# ── Node / React ──
node_modules/
dist/
build/
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── IDE — IntelliJ IDEA ──
.idea/
*.iws
*.iml
*.ipr
out/

# ── IDE — Eclipse ──
.classpath
.project
.settings/
bin/

# ── IDE — VS Code ──
.vscode/
*.code-workspace

# ── IDE — NetBeans ──
/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/

# ── Docker ──
docker-compose.override.yml

# ── OS Files ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ── Misc ──
*.swp
*.swo
*~
.cache/
ERRORS.md
.agent/

# ── Local tool config ──
.mcp.json

# ── Scratch output của script kiểm tra / diff tạm ──
# các file này do script chạy tay sinh ra, không phải nguồn của repo.
web/spec-ids-report.txt
web/spec-lines.json
web/spec-remaining.json
web/merge-conflicts.txt
web/merge-content-changed.txt
web/noise-list.txt
web/noise-only-files.txt
web/content-changed-files.txt
web/doc/_tmp_img/
web/tmp-*
web/scripts/tmp-*
# Spec debug tạm trong `web/e2e/` — không bao giờ được commit (Playwright đã
# loại trừ ở `playwright.config.ts`, nhưng gitignore là lớp chặn đầu tiên).
web/e2e/_tmp*/
web/e2e/_tmp-*
web/e2e/tmp-*
web/preview.err
web/preview.out
