# =============================================
# MoonKage / Bake2B - environment variables
# Loaded by DotEnvConfig (every service) when run from the IDE.
# docker compose reads it via env_file and overrides the *_DB_HOST/PORT and EUREKA_URL values.
# Real OS environment variables override this file.
# =============================================

# ── PostgreSQL: one container per service (host ports from docker-compose.yml) ──
DB_USERNAME=bake2b
DB_PASSWORD=bake2b_secret

IDENTITY_DB_HOST=localhost
IDENTITY_DB_PORT=5441
CATALOG_DB_HOST=localhost
CATALOG_DB_PORT=5442
QUOTATION_DB_HOST=localhost
QUOTATION_DB_PORT=5443
ORDER_DB_HOST=localhost
ORDER_DB_PORT=5444
VENDOR_DB_HOST=localhost
VENDOR_DB_PORT=5445
PAYMENT_DB_HOST=localhost
PAYMENT_DB_PORT=5446
NOTIFICATION_DB_HOST=localhost
NOTIFICATION_DB_PORT=5447

# ── RabbitMQ (domain events between services) ──
# management UI: http://localhost:15672
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=moonkage
RABBITMQ_PASSWORD=moonkage_secret

# ── Eureka ──
EUREKA_URL=http://localhost:8761/eureka/

# ── JWT (identity-service signs, api-gateway verifies: must be the SAME value) ──
# Base64 HS256 key, at least 32 bytes. Generate: openssl rand -base64 48
JWT_SECRET=<openssl rand -base64 48>
# milliseconds: 12h access token, 7 days refresh token
JWT_EXPIRATION=43200000
JWT_REFRESH_EXPIRATION=604800000

# ── OTP (register / forgot password) ──
OTP_EXPIRATION=5m
OTP_MAX_ATTEMPTS=5

# ── SMTP for OTP e-mails (e.g. Gmail: smtp.gmail.com + App Password) ──
# Leave MAIL_HOST empty in local dev: OTP codes are printed to the identity-service log instead.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Admin account created on first start ──
ADMIN_EMAIL=admin@moonkage.vn
ADMIN_PASSWORD=<admin password>

# ── api-gateway CORS (comma separated) ──
CORS_ORIGINS=http://localhost:5173

# ── MinIO (file-service), same values as the Capstone project ──
# Console: http://localhost:9001. Inside Docker file-service reaches it as http://minio:9000.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=ecommerce
