# =============================================
# MoonKage / Bake2B - environment variables
# Loaded by DotEnvConfig (every service) when run from the IDE.
# docker compose reads it via env_file and overrides the *_DB_HOST/PORT and EUREKA_URL values.
# Real OS environment variables override this file.
# =============================================

# ── PostgreSQL: one container per service (host ports from docker-compose.yml) ──
DB_USERNAME=bake2b
DB_PASSWORD=bake2b_secret

IDENTITY_DB_HOST=localhost
IDENTITY_DB_PORT=5441
CATALOG_DB_HOST=localhost
CATALOG_DB_PORT=5442
QUOTATION_DB_HOST=localhost
QUOTATION_DB_PORT=5443
ORDER_DB_HOST=localhost
ORDER_DB_PORT=5444
VENDOR_DB_HOST=localhost
VENDOR_DB_PORT=5445
PAYMENT_DB_HOST=localhost
PAYMENT_DB_PORT=5446
ORCHESTRATOR_DB_HOST=localhost
ORCHESTRATOR_DB_PORT=5447

# ── RabbitMQ (domain events between services) ──
# management UI: http://localhost:15672
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=moonkage
RABBITMQ_PASSWORD=moonkage_secret

# ── Eureka ──
EUREKA_URL=http://localhost:8761/eureka/

# ── JWT (identity-service signs, api-gateway verifies: must be the SAME value) ──
# Base64 HS256 key, at least 32 bytes. Generate: openssl rand -base64 48
JWT_SECRET=<openssl rand -base64 48>
# milliseconds: 12h access token, 7 days refresh token
JWT_EXPIRATION=43200000
JWT_REFRESH_EXPIRATION=604800000

# ── Debug: print every SQL statement of identity-service (off by default) ──
# JPA_SHOW_SQL=true

# ── OTP (register / forgot password) ──
OTP_EXPIRATION=5m
OTP_MAX_ATTEMPTS=5

# ── SMTP for OTP e-mails (e.g. Gmail: smtp.gmail.com + App Password) ──
# Leave MAIL_HOST empty in local dev: OTP codes are printed to the identity-service log instead.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ── NFC verification keys (FR-04, Software Design D-08, D-17): identity-service only, never commit real ones ──
# RSA private key that opens what the app encrypts. ONE line: the Base64 between the PEM BEGIN/END lines.
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out nfc.pem   (body of nfc.pem goes here)
#   openssl pkey -in nfc.pem -pubout   -> NFC_TRANSPORT_PUBLIC_KEY in mobile env/*.json (the app reads PEM)
NFC_TRANSPORT_PRIVATE_KEY_V1=
# AES-256 key that locks the ID number / date of birth in the database: openssl rand -base64 32
PII_ENC_KEY_V1=
# Secret for the ID number fingerprint, different per environment: openssl rand -base64 32
ID_HASH_PEPPER_V1=
# vendor-service only (P-09): AES-256-GCM key of vendors' bank account numbers, 32 random bytes in Base64
# (openssl rand -base64 32). Without it a vendor profile cannot be submitted.
BANK_ACCOUNT_ENC_KEY_V1=

# ── Dev seed data (docs/guides/database.md): one password for every seed account, admin@mk.com and member1@mk.com … member5@mk.com ──
SEED_PASSWORD=12345678

# ── api-gateway CORS (comma separated) ──
CORS_ORIGINS=http://localhost:5173
# Optional: regex of client IPs whose requests get X-Forwarded-* headers (default: loopback + private networks).
# Without them services build URLs (Swagger "Try it out") from their container IP.
# GATEWAY_TRUSTED_PROXIES=

# ── MinIO, used directly by the services that own files (catalog, vendor now; order later) ──
# Console: http://localhost:9001. Inside Docker the services reach it as http://minio:9000.
# Browsers PUT/GET files on port 9000 through presigned links.
# The root account is used only by the minio and minio-init containers (infra/minio/init.sh); services get their own user.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Host browsers use to reach MinIO: image URLs and presigned links are built/signed for it.
# Default http://localhost:${MINIO_API_PORT}; on a server set it, e.g. https://files.example.com
# MINIO_BROWSER_URL=
# public = anonymously readable (product images); private = presigned links only, plus unconfirmed uploads;
# vendor-docs = vendor legal documents, reachable only by vendor-service (Software Design section 8)
MINIO_PUBLIC_BUCKET=moonkage-public
MINIO_PRIVATE_BUCKET=moonkage-private
MINIO_VENDOR_DOCS_BUCKET=moonkage-vendor-docs
# One MinIO user per service, created by minio-init and limited to that service's key prefixes.
# Secret keys: at least 8 characters. Change them on any shared or deployed environment.
MINIO_CATALOG_ACCESS_KEY=catalog-service
MINIO_CATALOG_SECRET_KEY=change-me-catalog-secret
MINIO_ORDER_ACCESS_KEY=order-service
MINIO_ORDER_SECRET_KEY=change-me-order-secret
MINIO_VENDOR_ACCESS_KEY=vendor-service
MINIO_VENDOR_SECRET_KEY=change-me-vendor-secret
# optional: how long unconfirmed uploads are kept (minio-init), link lifetimes (each service's application.yml)
# MINIO_TEMP_RETENTION_DAYS=1
# MINIO_REGION=us-east-1
# MINIO_UPLOAD_LINK_LIFETIME=10m
# MINIO_DOWNLOAD_LINK_LIFETIME=10m
# product images a Shop may upload (catalog-service)
# PRODUCT_IMAGE_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp
# PRODUCT_IMAGE_MAX_SIZE=5MB

# ─── VNPay sandbox (payment-service, A-11) ───
# Merchant values from https://sandbox.vnpayment.vn (TMN code and hash secret of your sandbox account).
# The IPN URL to register with VNPay: <public gateway URL>/payment-service/api/payments/vnpay/ipn
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# web result page (M4.3); it forwards VNPay's query to GET /payment-service/api/payments/vnpay/return
VNPAY_RETURN_URL=http://localhost:5173/thanh-toan/ket-qua
