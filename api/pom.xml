<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.moonkage</groupId>
    <artifactId>api</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Moonkage Platform</name>
    <description>Mooncake Platform — Microservices Architecture</description>

    <modules>
        <module>common-storage</module>
        <module>discovery-server</module>
        <module>api-gateway</module>
        <module>identity-service</module>
        <module>catalog-service</module>
        <module>quotation-service</module>
        <module>order-service</module>
        <module>vendor-service</module>
        <module>payment-service</module>
        <module>orchestrator-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <spring-cloud.version>2025.0.3</spring-cloud.version>
        <springdoc.version>2.9.1</springdoc.version>
        <!-- Newer than Spring Boot's managed version so Lombok also works on JDK 25 -->
        <lombok.version>1.18.48</lombok.version>

        <!-- ===== T0–T1 tool versions ===== -->
        <spotless.version>3.10.4</spotless.version>
        <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
        <checkstyle.version>13.11.0</checkstyle.version>
        <error-prone.version>2.50.0</error-prone.version>
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>

        <!-- ===== T4 tool versions ===== -->
        <archunit.version>1.5.1</archunit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- T4 — ArchUnit: layering rules, run as a test in every module (config/archunit/) -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <repositories>
        <!-- Ép Maven Central dùng HTTPS chuẩn -->
        <repository>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
            <id>central</id>
            <name>Central Repository</name>
            <url>https://repo.maven.apache.org/maven2</url>
        </repository>
        <!-- Vô hiệu hóa kho lưu trữ cũ của java.net gây lỗi chứng chỉ -->
        <repository>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
            <id>jvnet-nexus-releases</id>
            <url>https://maven.java.net/content/repositories/releases/</url>
        </repository>
    </repositories>

    <pluginRepositories>
        <!-- Vô hiệu hóa ở cả pluginRepositories nếu bị plugin gọi ngầm -->
        <pluginRepository>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
            <id>jvnet-nexus-releases</id>
            <url>https://maven.java.net/content/repositories/releases/</url>
        </pluginRepository>
    </pluginRepositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- T0 — Spotless: auto-format.
                 ./mvnw spotless:apply → reformat; spotless:check runs in validate -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <!-- LF everywhere, matching .editorconfig and CI (otherwise Windows gets CRLF) -->
                    <lineEndings>UNIX</lineEndings>
                    <java>
                        <!-- Palantir: 4-space indent, 120 columns — matches .editorconfig and Checkstyle -->
                        <palantirJavaFormat>
                            <style>PALANTIR</style>
                            <formatJavadoc>false</formatJavadoc>
                        </palantirJavaFormat>
                        <importOrder/>
                        <removeUnusedImports/>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                    </java>
                    <pom>
                        <sortPom>
                            <expandEmptyElements>false</expandEmptyElements>
                            <nrOfIndentSpace>4</nrOfIndentSpace>
                            <indentAttribute>schemaLocation</indentAttribute>
                        </sortPom>
                    </pom>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>validate</phase>
                    </execution>
                </executions>
            </plugin>

            <!-- T1 — Checkstyle: per-file syntax rules (naming, banned imports/patterns, magic numbers…) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${maven-checkstyle-plugin.version}</version>
                <configuration>
                    <!-- Absolute path so every submodule resolves the shared config -->
                    <configLocation>${maven.multiModuleProjectDirectory}/config/checkstyle/checkstyle.xml</configLocation>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <consoleOutput>true</consoleOutput>
                    <failOnViolation>true</failOnViolation>
                    <violationSeverity>warning</violationSeverity>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>${checkstyle.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>checkstyle</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>validate</phase>
                    </execution>
                </executions>
            </plugin>

            <!-- T4 — ArchUnit: one shared rule set, compiled into every module's tests.
                 Dockerfiles do not copy config/, so image builds simply skip it. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-architecture-tests</id>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <phase>generate-test-sources</phase>
                        <configuration>
                            <sources>
                                <source>${maven.multiModuleProjectDirectory}/config/archunit</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- T1 — Error Prone: semantic checks at compile time. Requires .mvn/jvm.config. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <release>${java.version}</release>
                    <encoding>UTF-8</encoding>
                    <!-- UnusedVariable is WARN while controllers/services are still stubs with unused
                         injected fields; raise it back to ERROR once they are implemented. -->
                    <compilerArgs>
                        <arg>-XDcompilePolicy=simple</arg>
                        <arg>--should-stop=ifError=FLOW</arg>
                        <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
                        <arg>-Xplugin:ErrorProne
                            -XepDisableWarningsInGeneratedCode
                            -XepExcludedPaths:.*/target/generated-sources/.*
                            -Xep:UnusedVariable:WARN
                            -Xep:UnusedMethod:ERROR
                            -Xep:ReferenceEquality:ERROR
                            -Xep:DefaultCharset:ERROR
                            -Xep:StringSplitter:ERROR
                            -Xep:JavaTimeDefaultTimeZone:ERROR
                            -Xep:BadImport:ERROR
                            -Xep:MissingCasesInEnumSwitch:ERROR
                            -Xep:EqualsGetClass:ERROR</arg>
                    </compilerArgs>
                    <!-- Setting this disables processor discovery, so Lombok must be listed explicitly -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>com.google.errorprone</groupId>
                            <artifactId>error_prone_core</artifactId>
                            <version>${error-prone.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
