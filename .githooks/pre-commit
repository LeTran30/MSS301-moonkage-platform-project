#!/usr/bin/env bash
# T0–T1 checks before every commit. Enable once per machine:
#   git config core.hooksPath .githooks
set -euo pipefail

# Skip quickly when no backend .java / pom.xml file is staged
if ! git diff --cached --name-only --diff-filter=ACMR | grep -qE '^backend/.*(\.java|pom\.xml)$'; then
  exit 0
fi

cd "$(git rev-parse --show-toplevel)/backend"

echo "▶ Checking format (Spotless) and Checkstyle..."
if ! ./mvnw -q -B spotless:check checkstyle:check; then
  echo ""
  echo "✖ Commit blocked."
  echo "  - Format errors:     cd backend && ./mvnw spotless:apply, then git add again."
  echo "  - Checkstyle errors: fix them as reported above."
  exit 1
fi
