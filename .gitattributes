# Normalize line endings: LF in the repo and working tree (matches .editorconfig)
* text=auto eol=lf

# Windows scripts must keep CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.webp binary
*.svgz binary
*.pdf binary
*.xlsx binary
*.docx binary
*.pptx binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp4 binary
