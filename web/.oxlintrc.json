{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "@/features/*/**",
              "@/entities/*/**",
              "@/widgets/*/**",
              "@/pages/*/*/**",
              "../features/*/*",
              "../../features/*/*",
              "../entities/*/*",
              "../../entities/*/*",
              "../widgets/*/*",
              "../../widgets/*/*",
              "../pages/*/*/*",
              "../../pages/*/*/*"
            ],
            "message": "Không import sâu vào nội bộ slice. Chỉ import qua Public API (index.ts) của slice."
          },
          {
            "group": ["@/app", "@/app/*", "../app/*", "../../app/*"],
            "message": "Không được import ngược lên tầng app/."
          },
          {
            "group": ["@/pages", "@/pages/*"],
            "message": "Import page qua slice của nó: @/pages/<khu vực>/<trang>."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/pages/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/*/**", "@/entities/*/**", "@/widgets/*/**"],
                "message": "Không import sâu vào nội bộ slice. Chỉ import qua Public API (index.ts) của slice."
              },
              { "group": ["@/app", "@/app/*"], "message": "Không được import ngược lên tầng app/." },
              { "group": ["@/pages", "@/pages/**"], "message": "Page không import page khác. Phần dùng chung đưa xuống widgets, features hoặc entities." },
              { "group": ["../**"], "message": "Không dùng đường dẫn tương đối ra khỏi slice. Import tầng khác qua alias @/." }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/widgets/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/*/**", "@/entities/*/**"],
                "message": "Không import sâu vào nội bộ slice. Chỉ import qua Public API (index.ts) của slice."
              },
              { "group": ["@/app", "@/app/*"], "message": "Không được import ngược lên tầng app/." },
              { "group": ["@/pages", "@/pages/*"], "message": "Widget chỉ import xuống features, entities, shared." },
              { "group": ["@/widgets", "@/widgets/*"], "message": "Widget không import widget khác. Việc ghép hai widget thuộc pages." },
              { "group": ["../../**"], "message": "Không dùng đường dẫn tương đối ra khỏi slice. Import tầng khác qua alias @/." }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/entities/*/**"],
                "message": "Không import sâu vào nội bộ slice. Chỉ import qua Public API (index.ts) của slice."
              },
              { "group": ["@/app", "@/app/*"], "message": "Không được import ngược lên tầng app/." },
              { "group": ["@/pages", "@/pages/*", "@/widgets", "@/widgets/*"], "message": "Feature chỉ import xuống entities, shared." },
              { "group": ["@/features", "@/features/*"], "message": "Feature không import feature khác. Phần dùng chung đưa xuống entities; việc phối hợp thuộc widgets hoặc pages." },
              { "group": ["../../**"], "message": "Không dùng đường dẫn tương đối ra khỏi slice. Import tầng khác qua alias @/." }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/entities/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "group": ["@/app", "@/app/*"], "message": "Không được import ngược lên tầng app/." },
              { "group": ["@/pages", "@/pages/*", "@/widgets", "@/widgets/*", "@/features", "@/features/*"], "message": "Entity chỉ import xuống shared." },
              { "group": ["@/entities", "@/entities/*"], "message": "Entity không import entity khác. Đưa phần dùng chung xuống shared, hoặc ghép ở tầng trên." },
              { "group": ["../../**"], "message": "Không dùng đường dẫn tương đối ra khỏi slice. Import tầng khác qua alias @/." }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app", "@/app/*", "@/pages", "@/pages/*", "@/widgets", "@/widgets/*", "@/features", "@/features/*", "@/entities", "@/entities/*"],
                "message": "shared không biết nghiệp vụ: chỉ import trong shared."
              }
            ]
          }
        ]
      }
    }
  ]
}
