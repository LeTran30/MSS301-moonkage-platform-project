{
  "name": "moonkage-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src e2e",
    "lint:css": "node scripts/check-css-modules.mjs",
    "lint:responsive": "node scripts/check-responsive.mjs",
    "lint:contrast": "node scripts/check-contrast.mjs",
    "lint:fsd": "node scripts/check-fsd-layers.mjs",
    "lint:orphan-css": "node scripts/check-orphan-css.mjs",
    "test": "vitest run",
    "check": "oxlint src e2e && node scripts/check-css-modules.mjs && node scripts/check-responsive.mjs && node scripts/check-orphan-css.mjs && node scripts/check-no-spec-ids.mjs && node scripts/check-contrast.mjs && node scripts/check-fsd-layers.mjs && tsc -b && vitest run && vite build && node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "coverage": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "e2e:install": "playwright install chromium",
    "check:all": "npm run check && npm run e2e"
  },
  "dependencies": {
    "@sentry/react": "^11.10.0",
    "@stomp/stompjs": "^7.3.0",
    "@tanstack/react-query": "^5.105.2",
    "axios": "^1.21.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@axe-core/react": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-axe": "^0.1.0"
  }
}
