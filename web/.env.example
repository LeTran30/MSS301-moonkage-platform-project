# API Gateway của backend Moonkage (ví dụ: http://localhost:8080)
VITE_API_BASE_URL=http://localhost:8080

# WebSocket của backend (FR-27: realtime tiến độ đơn hàng)
VITE_WS_URL=

# Origin của object storage phục vụ ảnh sản phẩm / ảnh báo giá (MinIO).
# Dùng cho `img-src` của CSP: thiếu biến này thì ảnh trong danh mục bị chặn
# và hiện ô trống. Nhiều origin thì tách bằng dấu phẩy.
VITE_MEDIA_BASE_URL=http://localhost:9000

# ------------------------------------------------------------------
# Chế độ xác thực
# ------------------------------------------------------------------
# `bearer` (mặc định): token trong header `Authorization`, token nằm trong
#   token vault (memory + sessionStorage).
# `cookie`: backend quản lý cookie `HttpOnly; Secure; SameSite=Strict`.
#   Trình duyệt tự gửi cookie, không có token nào trong JS để bị đánh cắp.
#   Cần backend trả `Access-Control-Allow-Credentials: true`.
VITE_AUTH_MODE=bearer

# ------------------------------------------------------------------
# Feature flags — tắt/bật tính năng không cần deploy lại
# ------------------------------------------------------------------
# Tên biến = VITE_FEATURE_ + tên cờ ở dạng SCREAMING_SNAKE_CASE.
# Cờ mới mặc định tắt; cờ đã ổn định mặc định bật.
# Xem `src/shared/config/featureFlags.ts` để biết danh sách cờ.
VITE_FEATURE_NEW_CHECKOUT=false
VITE_FEATURE_VENDOR_ANALYTICS=false
VITE_FEATURE_OTP_VIA_ZNS=false
VITE_FEATURE_REALTIME_UPDATES=true

# ------------------------------------------------------------------
# Observability — Sentry + analytics + Core Web Vitals
# ------------------------------------------------------------------
# Cả ba đều OPT-IN: để trống thì KHÔNG có request nào đi ra ngoài.
#
# Ranh giới dữ liệu (NFR-03): không gửi tên, email, số điện thoại, địa chỉ,
# nội dung form hay số tiền. Sentry chỉ nhận user.id (mã tài khoản) + user.role.

# DSN của Sentry (https://<key>@o0.ingest.sentry.io/0). Rỗng = tắt Sentry.
VITE_SENTRY_DSN=
# Môi trường để lọc lỗi theo stage: production | staging | development
VITE_OBSERVABILITY_ENVIRONMENT=development
# Tên môi trường chung (dùng làm fallback khi VITE_OBSERVABILITY_ENVIRONMENT rỗng).
# VITE_APP_ENV=development
# Phiên bản ứng dụng (git sha) — gắn vào mọi event
VITE_APP_VERSION=
# Tỷ lệ lấy mẫu trace (0..1)
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# Session Replay: ghi lại thao tác người dùng. Nạp từ CDN nên không tốn bundle.
# Bật tuỳ chọn và có chủ đích — có thể chứa thông tin nhạy cảm.
VITE_SENTRY_REPLAYS=false
VITE_SENTRY_REPLAYS_SAMPLE_RATE=0

# GA4 measurement ID (G-XXXXXXXXXX). Rỗng = tắt analytics.
VITE_GA_MEASUREMENT_ID=
# GA4 host (mặc định https://www.googletagmanager.com)
VITE_GA_HOST=
