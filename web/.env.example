# Copy to .env.local (ignored by git). Vite only exposes keys starting with VITE_.

# API gateway. Same machine: http://localhost:8080; phone on the LAN: the PC's IPv4, e.g. http://192.168.1.10:8080
VITE_API_BASE_URL=http://localhost:8080

# How often the NFC page asks the server whether the QR was used: while the WebSocket (gateway /ws) is down,
# and while it is up (then the push does the work and the poll only covers a missed message)
VITE_NFC_POLL_INTERVAL_MS=2000
VITE_NFC_POLL_INTERVAL_CONNECTED_MS=15000
