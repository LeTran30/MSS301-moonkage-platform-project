@startuml
' MoonKage conceptual ERD — aligned with Requirement v0.1 section 7.1
hide circle
hide empty members
left to right direction
skinparam linetype ortho

package "Identity Service" {
    entity "USERS" as users
    entity "VERIFICATION_CODES" as verification_codes
    entity "ADDRESSES" as addresses
    entity "VENDORS" as vendors
    entity "VENDOR_DOCUMENTS" as vendor_documents
}

package "Catalog Service" {
    entity "PRODUCTS" as products
    entity "PRODUCT_PRICE_TIERS" as product_price_tiers
    entity "ORDER_PROFILES" as order_profiles
    entity "REF_PRICE_TIERS" as ref_price_tiers
    entity "VENDOR_DELIVERY_AREAS" as delivery_areas
    entity "REVIEWS" as reviews
}

package "Tender Service" {
    entity "TENDER_REQUESTS" as tender_requests
    entity "TENDER_INVITATIONS" as tender_invitations
    entity "QUOTES" as quotes
    entity "SEASONS" as seasons
}

package "Order Service" {
    entity "CART_ITEMS" as cart_items
    entity "ORDERS" as orders
    entity "ORDER_ITEMS" as order_items
    entity "PAYMENTS" as payments
    entity "LEDGERS" as ledgers
    entity "MOCKUP_VERSIONS" as mockup_versions
    entity "PROGRESS_UPDATES" as progress_updates
    entity "DISBURSEMENT_REQUESTS" as disbursement_requests
    entity "DISPUTES" as disputes
    entity "DISPUTE_EVIDENCES" as dispute_evidences
    entity "VOUCHERS" as vouchers
    entity "COMMISSION_CONFIGS" as commission_configs
    entity "COMMISSION_INVOICES" as commission_invoices
}

' every service also has its own AUDIT_LOGS table (NFR-07)

' ===== internal =====
users ||--o{ verification_codes : "verifies with"
users ||--o{ addresses : "saves"
users ||--o| vendors : "owns (exactly one owner)"
vendors ||--o{ vendor_documents : "submits"

products ||--o{ product_price_tiers : "has"
order_profiles ||--o{ ref_price_tiers : "has"

tender_requests ||--o{ tender_invitations : "invites"
tender_requests ||--o{ quotes : "receives"

orders ||--o{ order_items : "contains"
orders ||--o{ payments : "has"
orders ||--|| ledgers : "escrow"
orders ||--o{ mockup_versions : "has"
orders ||--o{ progress_updates : "tracks"
orders ||--o{ disbursement_requests : "releases deposit"
orders ||--o{ disputes : "has"
disputes ||--o{ dispute_evidences : "has"

' ===== cross-service (id only, no FK) =====
vendors ||..o{ products : "lists"
vendors ||..o| order_profiles : "declares"
vendors ||..o{ delivery_areas : "delivers to"
users ||..o{ tender_requests : "creates"
vendors ||..o{ tender_invitations : "is invited"
vendors ||..o{ quotes : "sends"
quotes |o..o| orders : "accepted + deposit = order"
users ||..o{ cart_items : "fills"
products ||..o{ cart_items : "in"
users ||..o{ orders : "buys"
vendors ||..o{ orders : "fulfils"
products |o..o{ order_items : "copied from"
orders ||..o{ reviews : "reviewed in"
vendors ||..o{ commission_invoices : "billed"
@enduml
