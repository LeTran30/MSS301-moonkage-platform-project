<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Checkstyle cho T1 (câu lệnh / biểu thức).
  KHÔNG kiểm tra thụt lề, khoảng trắng, thứ tự import: phần T0 đó do Spotless tự sửa.
  Dùng cả hai cho cùng một việc sẽ gây xung đột.

  Bỏ qua một vi phạm có chủ đích: @SuppressWarnings("checkstyle:<tenCheck>") kèm comment giải thích.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <module name="SuppressWarningsFilter"/>

    <!-- Literal values are normal in test assertions -->
    <module name="SuppressionSingleFilter">
        <property name="checks" value="MagicNumber"/>
        <property name="files" value="[\\/]src[\\/]test[\\/]"/>
    </module>

    <!-- Bỏ qua code sinh tự động -->
    <module name="BeforeExecutionExclusionFileFilter">
        <property name="fileNamePattern" value=".*[\\/]target[\\/].*"/>
    </module>

    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^(package|import) .*|^\s*\* .*https?://.*"/>
    </module>

    <module name="TreeWalker">
        <module name="SuppressWarningsHolder"/>

        <!-- ===== Đặt tên ===== -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="MemberName"/>
        <module name="ParameterName"/>
        <module name="LambdaParameterName"/>
        <module name="LocalVariableName"/>
        <module name="LocalFinalVariableName"/>
        <module name="PatternVariableName"/>
        <module name="RecordComponentName"/>
        <module name="StaticVariableName"/>
        <module name="ConstantName">
            <!-- Cho phép logger đặt tên "log" theo quy ước SLF4J -->
            <property name="format" value="^(log|[A-Z][A-Z0-9]*(_[A-Z0-9]+)*)$"/>
        </module>
        <module name="ClassTypeParameterName"/>
        <module name="MethodTypeParameterName"/>
        <module name="AbbreviationAsWordInName">
            <property name="allowedAbbreviationLength" value="3"/>
            <property name="ignoreFinal" value="false"/>
        </module>

        <!-- ===== Import ===== -->
        <module name="AvoidStarImport"/>
        <module name="RedundantImport"/>
        <module name="UnusedImports"/>
        <module name="IllegalImport">
            <!-- Thời gian dùng java.time, không dùng API cũ -->
            <property name="illegalClasses"
                      value="java.util.Date, java.util.Calendar, java.util.GregorianCalendar"/>
        </module>

        <!-- ===== Câu lệnh & biểu thức ===== -->
        <module name="NeedBraces"/>
        <module name="EmptyBlock">
            <property name="option" value="TEXT"/>
        </module>
        <module name="EmptyCatchBlock"/>
        <module name="MissingSwitchDefault"/>
        <module name="FallThrough"/>
        <module name="OneStatementPerLine"/>
        <module name="MultipleVariableDeclarations"/>
        <module name="InnerAssignment"/>
        <module name="ModifiedControlVariable"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="StringLiteralEquality"/>
        <module name="EqualsHashCode"/>
        <module name="UpperEll"/>
        <module name="ArrayTypeStyle"/>
        <module name="IllegalCatch">
            <property name="illegalClassNames" value="Throwable, java.lang.Throwable, Error, java.lang.Error"/>
        </module>
        <module name="MagicNumber">
            <property name="ignoreNumbers" value="-1, 0, 1, 2"/>
            <property name="ignoreHashCodeMethod" value="true"/>
            <property name="ignoreAnnotation" value="true"/>
            <property name="ignoreFieldDeclaration" value="true"/>
        </module>

        <!-- ===== Pattern bị cấm (quy tắc riêng của dự án) ===== -->
        <module name="RegexpSinglelineJava">
            <property name="id" value="noSystemOut"/>
            <property name="format" value="System\.(out|err)\.print"/>
            <property name="ignoreComments" value="true"/>
            <property name="message" value="Dùng SLF4J logger, không dùng System.out/err."/>
        </module>
        <module name="RegexpSinglelineJava">
            <property name="id" value="noPrintStackTrace"/>
            <property name="format" value="\.printStackTrace\(\s*\)"/>
            <property name="ignoreComments" value="true"/>
            <property name="message" value="Không dùng printStackTrace(); log qua logger: log.error(&quot;...&quot;, ex)."/>
        </module>
        <module name="RegexpSinglelineJava">
            <property name="id" value="noLogConcat"/>
            <property name="format" value="\blog\.(trace|debug|info|warn|error)\(\s*&quot;[^&quot;]*&quot;\s*\+"/>
            <property name="ignoreComments" value="true"/>
            <!-- Không viết dấu ngoặc nhọn trong message: Checkstyle hiểu đó là tham số và crash -->
            <property name="message" value="Dùng placeholder của SLF4J thay vì nối chuỗi trong log."/>
        </module>
        <module name="RegexpSinglelineJava">
            <property name="id" value="noFloatingMoney"/>
            <property name="format" value="\b(double|float|Double|Float)\s+\w*([Pp]rice|[Aa]mount|[Tt]otal|[Bb]alance|[Ff]ee)\w*\s*[=;,)]"/>
            <property name="ignoreComments" value="true"/>
            <property name="message" value="Tiền tệ dùng BigDecimal, không dùng double/float."/>
        </module>
        <module name="MatchXpath">
            <property name="id" value="noFieldInjection"/>
            <property name="query" value="//VARIABLE_DEF[./MODIFIERS/ANNOTATION/IDENT[@text='Autowired']]"/>
            <message key="matchxpath.match" value="Dùng constructor injection, không đặt @Autowired trên field."/>
        </module>
        <module name="TodoComment">
            <!-- Cho phép TODO(owner) hoặc TODO(#123), cấm TODO trơn -->
            <property name="format" value="(TODO|FIXME)(?!\()"/>
        </module>
    </module>
</module>
